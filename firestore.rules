rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{id} {
      allow read, write: if isSignedIn();
    }

    match /clients/{id} {
      allow read, write: if isSignedIn();
    }

    match /projects/{id} {
      allow read, write: if isSignedIn();
    }

    match /tasks/{id} {
      allow read, write: if isSignedIn();
    }

    match /files/{id} {
      allow read, write: if isSignedIn();
    }

    match /comments/{id} {
      allow read, write: if isSignedIn();
    }

    match /projectGuests/{id} {
      allow read, write: if isSignedIn();
    }

    match /drawings/{drawingId} {
      allow read, write: if isSignedIn();
    }
  }
}
